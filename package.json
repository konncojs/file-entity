{
  "name": "@konncojs/file-entity",
  "version": "0.2.3",
  "description": "A lightweight model for file metadata.",
  "type": "module",
  "types": "./dist/index.d.mts",
  "import": "./dist/index.mjs",
  "require": "./dist/index.cjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "release": "release-it",
    "build": "tsdown ./src/index.ts --dts --format=es,cjs",
    "test": "vitest"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "author": "Konnco Studio <support@konnco.com> (konnco)",
  "keywords": [],
  "license": "ISC",
  "packageManager": "pnpm@10.10.0",
  "devDependencies": {
    "release-it": "^19.0.6",
    "tsdown": "^0.16.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "release-it": {
    "github": {
      "release": true,
      "releaseName": "v${version}"
    },
    "git": {
      "tagName": "v${version}",
      "commitMessage": "v${version}",
      "tagAnnotation": "v${version}"
    }
  }
}
