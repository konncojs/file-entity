{
  "name": "@konnco/file-entity",
  "version": "0.3.2",
  "description": "A lightweight model for file metadata.",
  "type": "module",
  "types": "./dist/index.d.mts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "skills",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "release": "release-it",
    "build": "tsdown ./src/index.ts --dts --format=es,cjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --fix"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Konnco Studio <support@konnco.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/konncojs/file-entity.git"
  },
  "bugs": {
    "url": "https://github.com/konncojs/file-entity/issues"
  },
  "homepage": "https://github.com/konncojs/file-entity#readme",
  "keywords": [
    "file",
    "entity",
    "metadata",
    "upload",
    "typescript"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "@konnco/biomer": "^0.0.2",
    "release-it": "^21.0.2",
    "tsdown": "^0.16.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "release-it": {
    "github": {
      "release": true,
      "releaseName": "v${version}"
    },
    "git": {
      "tagName": "v${version}",
      "commitMessage": "v${version}",
      "tagAnnotation": "v${version}"
    },
    "npm": {
      "stage": true,
      "skipChecks": true
    }
  }
}
